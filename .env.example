# ─────────────────────────────────────────────
# Database (로컬: docker-compose, 운영: Supabase Postgres connection string)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/thegrandweb?schema=public"

# ─────────────────────────────────────────────
# 관리자 로그인 (별도 DB 계정 테이블 없이 환경변수로 관리)
# ─────────────────────────────────────────────
ADMIN_ID="admin"
ADMIN_PASSWORD="change-me-please"
# 세션 쿠키(JWT) 서명용 랜덤 문자열. 32자 이상 권장.
# 생성 예시: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string-32chars+"

# ─────────────────────────────────────────────
# Supabase (Postgres + Storage)
# 프로젝트 설정 > API 메뉴에서 값을 확인할 수 있습니다.
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# service_role 키는 서버(관리자 API)에서만 사용됩니다. 절대 클라이언트에 노출하지 마세요.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# 이벤트 이미지를 업로드할 공개(public) Storage 버킷 이름
SUPABASE_STORAGE_BUCKET="event-images"

# ─────────────────────────────────────────────
# 텔레그램 알림 (grammY)
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
# 알림을 받을 채팅방/채널 ID (봇을 채팅방에 초대한 뒤 확인)
TELEGRAM_CHAT_ID=""

# ─────────────────────────────────────────────
# AI 상담 (Anthropic Claude API)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# ─────────────────────────────────────────────
# 예약 완료 후 "바로 문의하기" 딥링크 대상
# ─────────────────────────────────────────────
# 카카오톡 채널 공개 ID (pf.kakao.com/_xxxx 형태의 채널 홈 URL에서 확인)
NEXT_PUBLIC_KAKAO_CHANNEL_ID="_xxxxxxx"
# 국가번호 포함, +기호나 공백 없이 (예: 84xxxxxxxxx)
NEXT_PUBLIC_WHATSAPP_PHONE=""
# Zalo는 보통 전화번호 기반 딥링크를 사용합니다.
NEXT_PUBLIC_ZALO_PHONE=""

# ─────────────────────────────────────────────
# 배포/공개 URL (메타데이터, 절대경로 링크 생성 등에 사용)
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
