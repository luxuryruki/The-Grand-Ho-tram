// Prisma schema — The Concierge Ho Tram
// 로컬 개발: docker-compose로 띄운 Postgres. 운영: Supabase Postgres.
// 참고: 모든 모델에 createdAt/updatedAt을 기본으로 두어, 추후 세일즈포스 등
// 외부 분석 플랫폼으로 데이터를 내보내기 쉽도록 했습니다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReservationStatus {
  NEW // 신규
  IN_PROGRESS // 확인중
  DONE // 완료
  CANCELED // 취소
}

/// 예약 요청자가 선호하는 1차 연락 수단. (딥링크로 추가 제공되는 WhatsApp/Zalo 등은
/// 이 값과 무관하게 결과 화면에서 항상 옵션으로 노출됩니다.)
enum PreferredChannel {
  TELEGRAM
  KAKAO
}

enum ConsultationRole {
  USER
  ASSISTANT
}

/// 이벤트 형태: 기간 이벤트(시작일~종료일) / 하루 이벤트(하루만 진행, startDate == endDate)
enum EventKind {
  PERIOD
  SINGLE_DAY
}

/// 이벤트 / 프로모션
model Event {
  id           String    @id @default(cuid())
  title        String
  description  String    @db.Text
  kind         EventKind @default(PERIOD)
  /// 이벤트가 진행되는 날짜(하루 이벤트는 startDate와 endDate가 같습니다)
  startDate    DateTime
  endDate      DateTime
  /// 공개 스위치. 꺼져 있으면 게시 기간과 상관없이 비공개입니다.
  isPublished  Boolean   @default(false)
  /// 게시 기간: 사이트에 노출되는 기간(한국 시간 기준). 비어 있으면 그 방향으로 제한이 없습니다.
  publishFrom  DateTime?
  publishUntil DateTime?

  images EventImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, startDate])
}

/// 이벤트에 속한 이미지 (여러 장, 노출 순서 order로 관리)
model EventImage {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url     String
  order   Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, order])
}

/// 관리자가 등록/관리하는 호텔 타입 옵션 (예: 스탠다드, 디럭스, 스위트)
model HotelType {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

/// 호텔 & 차량 예약 요청
model ReservationRequest {
  id String @id @default(cuid())

  /// 예약 요청 호텔의 표시 이름 (예: "InterContinental Grand Ho Tram")
  hotelName      String
  /// src/data/hotels 의 호텔 id / 객실 slug. 객실을 정하지 않았다면 roomSlug는 null.
  hotelId        String?
  roomSlug       String?
  roomName       String?
  /// 요청 시점에 선택한 객실이 프로모션 적용 가능 객실이었는지 (안내는 상담으로 진행)
  promoEligible  Boolean @default(false)
  /// 선택한 요금 구성(RoomRate.rateKey)과, 요청 시점에 서버가 계산한 대략적인 견적(VND).
  /// 참고용 금액이며 실제 요금은 상담 후 확정됩니다.
  rateKey        String?
  nights         Int?
  estimatedTotal Int?

  checkIn    DateTime
  checkOut   DateTime
  guestCount Int

  needsVehicle   Boolean @default(false)
  vehicleType    String?
  pickupLocation String?
  /// 픽업 날짜(YYYY-MM-DD)와 시간(HH:mm). 베트남 현지 시각 기준 문자열로 저장합니다.
  pickupDate     String?
  pickupTime     String?

  contactName      String
  contactPhone     String
  preferredChannel PreferredChannel @default(TELEGRAM)

  status ReservationStatus @default(NEW)

  /// 유입 경로 기록용. 예: "home", "events", "event:<eventId>"
  source String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

/// AI 상담 세션. `sessionId`는 브라우저 세션(anonymous)마다 발급되는 공개 식별자입니다.
model ConsultationSession {
  id        String    @id @default(cuid())
  sessionId String    @unique
  locale    String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  messages ConsultationMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConsultationMessage {
  id        String              @id @default(cuid())
  sessionId String
  session   ConsultationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      ConsultationRole
  content   String              @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, createdAt])
}

/// 범용 사용자 행동 로그 (추후 세일즈포스 등 외부 플랫폼 연동용)
model AnalyticsEvent {
  id        String  @id @default(cuid())
  sessionId String?
  /// 예: page_view, reservation_submit, consult_start, consult_message
  eventType String
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventType, createdAt])
  @@index([sessionId])
}

/// 객실 요금표 (VND, 서비스 요금·세금 포함 Nett). 엑셀 요금표를 `npm run db:import-rates`로 올립니다.
/// 하나의 요금 행이 여러 사이트 객실에 적용될 수 있고(roomSlugs), 반대로 하나의 사이트 객실에
/// 여러 요금 행(예: 침실 1개/2개 구성)이 연결될 수도 있습니다.
model RoomRate {
  id        String   @id @default(cuid())
  hotelId   String
  /// 요금 행의 고정 키 (영문 객실명 slug). 같은 호텔 안에서 유일합니다.
  rateKey   String
  nameEn    String
  nameKo    String
  roomCodes String[]
  /// 이 요금이 적용되는 사이트 객실 slug (src/data/hotels). 사이트에 없는 객실이면 빈 배열
  roomSlugs String[]

  weekday       Int
  /// 금요일 요금 컬럼이 없는 호텔은 null → 평일 요금을 적용
  friday        Int?
  saturday      Int
  publicHoliday Int

  /// 카지노 프로모션 적용 가능 객실 여부 (프로모션 내용은 상담으로 안내)
  promoEligible Boolean  @default(false)
  sortOrder     Int      @default(0)
  /// 이 날짜 이후 숙박분부터 적용되는 요금
  validFrom     DateTime @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hotelId, rateKey])
  @@index([hotelId, sortOrder])
}

/// 호텔별 추가 인원 요금, 세금/서비스 요금 안내값
model HotelRateInfo {
  hotelId String @id

  /// 3번째 인원부터의 추가 요금 (VND, Nett)
  extraBed             Int?
  bedAndBreakfastAdult Int?
  breakfastChild       Int?

  serviceChargePercent Int @default(5)
  taxPercent           Int @default(8)

  validFrom  DateTime @db.Date
  sourceFile String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 베트남 공휴일. 이 날짜의 숙박은 요금표의 "Public Holiday" 요금이 적용됩니다.
model PublicHoliday {
  id     String   @id @default(cuid())
  date   DateTime @unique @db.Date
  nameKo String
  nameEn String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 회원 가입 문의. 이름·연락처를 남기면 담당자가 연락해 가입을 안내합니다.
model MembershipInquiry {
  id               String            @id @default(cuid())
  name             String
  phone            String
  preferredChannel PreferredChannel  @default(KAKAO)
  message          String?           @db.Text
  /// 유입 경로. 예: "golf", "hotels", "home"
  source           String?
  /// 개인정보 수집·이용에 동의한 시각
  consentAt        DateTime
  status           ReservationStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

/// 골프 요금표(회원 전용 요금). 구조는 src/lib/golf-rates.ts 의 스키마를 따르며
/// 원본 파일은 저장소에 올리지 않고 `npm run db:import-golf-rates` 로 DB에만 올립니다.
model GolfRateSheet {
  id   String @id
  data Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
