// Prisma schema — THE GRAND
// 로컬 개발: docker-compose로 띄운 Postgres. 운영: Supabase Postgres.
// 참고: 모든 모델에 createdAt/updatedAt을 기본으로 두어, 추후 세일즈포스 등
// 외부 분석 플랫폼으로 데이터를 내보내기 쉽도록 했습니다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReservationStatus {
  NEW // 신규
  IN_PROGRESS // 확인중
  DONE // 완료
  CANCELED // 취소
}

/// 예약 요청자가 선호하는 1차 연락 수단. (딥링크로 추가 제공되는 WhatsApp/Zalo 등은
/// 이 값과 무관하게 결과 화면에서 항상 옵션으로 노출됩니다.)
enum PreferredChannel {
  TELEGRAM
  KAKAO
}

enum ConsultationRole {
  USER
  ASSISTANT
}

/// 이벤트 / 프로모션
model Event {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  startDate   DateTime
  endDate     DateTime
  isPublished Boolean  @default(false)

  images EventImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, startDate])
}

/// 이벤트에 속한 이미지 (여러 장, 노출 순서 order로 관리)
model EventImage {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url     String
  order   Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, order])
}

/// 관리자가 등록/관리하는 호텔 타입 옵션 (예: 스탠다드, 디럭스, 스위트)
model HotelType {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

/// 호텔 & 차량 예약 요청
model ReservationRequest {
  id String @id @default(cuid())

  hotelType  String
  checkIn    DateTime
  checkOut   DateTime
  guestCount Int

  needsVehicle   Boolean @default(false)
  vehicleType    String?
  pickupLocation String?

  contactName      String
  contactPhone     String
  preferredChannel PreferredChannel  @default(TELEGRAM)

  status ReservationStatus @default(NEW)

  /// 유입 경로 기록용. 예: "home", "events", "event:<eventId>"
  source String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

/// AI 상담 세션. `sessionId`는 브라우저 세션(anonymous)마다 발급되는 공개 식별자입니다.
model ConsultationSession {
  id        String    @id @default(cuid())
  sessionId String    @unique
  locale    String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  messages ConsultationMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConsultationMessage {
  id        String              @id @default(cuid())
  sessionId String
  session   ConsultationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      ConsultationRole
  content   String              @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, createdAt])
}

/// 범용 사용자 행동 로그 (추후 세일즈포스 등 외부 플랫폼 연동용)
model AnalyticsEvent {
  id        String   @id @default(cuid())
  sessionId String?
  /// 예: page_view, reservation_submit, consult_start, consult_message
  eventType String
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventType, createdAt])
  @@index([sessionId])
}
